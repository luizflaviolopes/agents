# Supabase project URL (from Supabase dashboard -> Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable key (sb_publishable_..., replaces the legacy "anon" key —
# either works). Used by the browser for AUTH ONLY (signup, login, session,
# sign-out). It has no table access (migration 0002 revoked it).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase secret key (sb_secret_..., replaces the legacy "service_role" key —
# either works; create one under Project Settings -> API Keys -> Secret keys).
# Full database access. Used at runtime by BOTH the web app's server (API
# routes / server components) AND the worker. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic API key used by the worker's Claude Agent SDK runtime
ANTHROPIC_API_KEY=

# Telegram bot token (from @BotFather) for the worker's Telegram bot
TELEGRAM_BOT_TOKEN=

# GitHub personal access token used to clone private repos into workspaces
GITHUB_TOKEN=

# Root directory on the worker's disk where workspace repos are cloned
WORKSPACES_ROOT=./workspaces-data

# Public URL of the web app. Reserved for future use (e.g. links in Telegram
# messages) — nothing reads it yet.
WEB_URL=http://localhost:3000

# How knowledge documents reach an agent's system prompt. 'manifest' (the
# default) lists titles, sizes and one-line previews and lets the agent pull
# what it needs with read_knowledge / search_knowledge; 'full' inlines every
# document on every run, the behaviour before migration 0007. Small knowledge
# bases are inlined either way — a manifest cannot pay for itself against a
# couple of short docs. Use 'full' to A/B the difference in task_runs.cost_usd.
KNOWLEDGE_INJECTION=manifest

# Task runs this worker executes at once. Each run spawns an Agent SDK
# subprocess, so raise it against available memory and your API rate limits,
# not CPU count. Default: 5.
WORKER_MAX_CONCURRENT_TASKS=5

# How long ask_agent blocks on a child task before giving up, in minutes.
# Prefer the async spawn_tasks tool for fan-out; this only bounds the
# blocking single-question path. Default: 10.
ASK_AGENT_TIMEOUT_MINUTES=10

# Post-run knowledge sweeps: when a run finishes, the worker enqueues a
# coalesced librarian sweep so learned facts reach the knowledge docs in
# minutes instead of waiting for the daily schedule. Set to false (or 0) to
# switch it off and leave the librarian on its schedule only. Default: on.
KNOWLEDGE_SWEEP_AFTER_RUNS=true

# Ceiling on one approved MCP tool call made by the action executor (0010),
# in seconds. This is a deterministic call with no model in the loop, so it
# only needs to cover the target server's own latency. Default: 120.
MCP_CALL_TIMEOUT_SECONDS=120
