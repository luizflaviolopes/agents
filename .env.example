# Supabase project URL (from Supabase dashboard -> Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon (public) key — safe for the browser, RLS applies
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key — server/worker only, bypasses RLS. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic API key used by the worker's Claude Agent SDK runtime
ANTHROPIC_API_KEY=

# Telegram bot token (from @BotFather) for the worker's Telegram bot
TELEGRAM_BOT_TOKEN=

# GitHub personal access token used to clone private repos into workspaces
GITHUB_TOKEN=

# Root directory on the worker's disk where workspace repos are cloned
WORKSPACES_ROOT=./workspaces-data

# Public URL of the web app. Reserved for future use (e.g. links in Telegram
# messages) — nothing reads it yet.
WEB_URL=http://localhost:3000
